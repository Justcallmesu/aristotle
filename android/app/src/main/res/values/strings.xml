    <!-- Settings -->
    <string name="nav_back">Back</string>
    <string name="settings_title">Settings</string>
    <string name="settings_keep_connected">Keep connected in background</string>
    <string name="settings_keep_connected_body">While Aristotle is closed, a silent notification keeps the link to your PC so you hear when a turn finishes or Hermes needs you. Stop it from that notification.</string>
    <string name="settings_notifications_off">Notifications are off</string>
    <string name="settings_notifications_off_body">Aristotle can\'t tell you when a turn finishes or Hermes needs you.</string>
    <string name="settings_battery_guide">Show the battery guide again</string>
    <string name="settings_battery_guide_body">Settings that keep Android from stopping Aristotle in the background.</string>

    <!-- Battery guide (mockup 6) -->
    <string name="guide_title">Keep Aristotle running</string>
    <string name="guide_body_xiaomi">HyperOS stops apps in the background. Without these three settings you can miss approvals and “turn finished” alerts.</string>
    <string name="guide_body_other">Android may stop apps in the background to save battery. Without this setting you can miss approvals and “turn finished” alerts.</string>
    <string name="guide_step_optimisation">Battery optimisation: off</string>
    <string name="guide_step_optimisation_body">Aristotle checks this one itself.</string>
    <string name="guide_step_saver">Battery saver: No restrictions</string>
    <string name="guide_step_saver_body">A HyperOS setting. Aristotle can\'t read it, so tick it when done.</string>
    <string name="guide_step_autostart">Autostart: on</string>
    <string name="guide_step_autostart_body">Also a HyperOS setting.</string>
