        <item quantity="other">%d messages</item>
    </plurals>
    <string name="sessions_empty_title">No open sessions</string>
    <string name="sessions_empty_body">Sessions open in Hermes on the laptop show up here.</string>

    <!-- Connection pages -->
    <string name="conn_details">Details</string>
    <string name="conn_retry_now">Retry now</string>
    <string name="conn_check_again">Check again</string>
    <string name="conn_pair_again">Pair again</string>
    <string name="conn_4503_title">Hermes isn\'t running</string>
    <string name="conn_4503_body">aristotle-server on %1$s answered, but Hermes is not running there. Start Hermes on the laptop; Aristotle reconnects by itself.</string>
    <string name="conn_4505_title">Hermes was updated</string>
    <string name="conn_4505_body">Hermes on %1$s now speaks a newer protocol than this aristotle-server knows, so the server stopped relaying to stay safe. Update aristotle-server on the laptop.</string>
    <string name="conn_list_title">Can\'t load the sessions</string>
    <string name="conn_list_body">Hermes on %1$s answered, but the session list failed. Retry; if it keeps failing, check Hermes on the laptop.</string>
    <string name="conn_cert_title">The laptop\'s certificate changed</string>
    <string name="conn_cert_body">Aristotle refused to connect: %1$s answered with a different certificate than the one you confirmed when pairing. If aristotle-server\'s key was deleted, pair again. Otherwise another device may be answering at this address.</string>

    <!-- Offline banner (T09) -->
    <string name="offline_title">PC offline since %1$s</string>
    <string name="offline_cause_unreachable">The laptop at %1$s doesn\'t answer on Wi-Fi or Tailscale. Check that it\'s awake and that aristotle-server is running.</string>
    <string name="offline_cause_tailscale">Tailscale may be off on this phone. Away from your Wi-Fi, Aristotle reaches the laptop only through Tailscale.</string>
    <string name="offline_cause_lost">The laptop at %1$s answered, then the connection ended.</string>
    <string name="offline_cause_app_error">Aristotle hit an unexpected error while connecting to %1$s. It tries again by itself.</string>
    <string name="offline_list_from">This list is from %1$s.</string>
    <string name="offline_reconnecting">Reconnecting… try %1$d</string>
    <string name="offline_reconnecting_next">Reconnecting… try %1$d, next in %2$d s</string>

    <!-- Stored pairing unreadable for now -->
    <string name="creds_unavailable_title">Can\'t open the pairing</string>
    <string name="creds_unavailable_body">Android\'s key store did not open this phone\'s pairing with the laptop. This is usually brief, right after the phone starts. Retry; if it keeps failing, pair again.</string>

