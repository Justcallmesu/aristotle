<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Aristotle</string>
    <string name="pair_command" translatable="false">aristotle-server pair</string>

    <!-- Pair screen -->
    <string name="pair_title">Pair with your PC</string>
    <string name="pair_lead">On the laptop, run %1$s. It shows a QR code, the address and a one-time code.</string>
    <string name="pair_address_label">Address</string>
    <string name="pair_address_help">Wi-Fi or Tailscale address. Port 8760 if you leave it out.</string>
    <string name="pair_code_label">Pairing code</string>
    <string name="pair_code_help">8 characters, valid for 5 minutes</string>
    <string name="pair_name_label">Device name</string>
    <string name="pair_name_help">Shown in the laptop\'s device list</string>
    <string name="pair_continue">Continue</string>
    <string name="pair_connecting">Connecting…</string>
    <string name="pair_action">Pair</string>
    <string name="pair_pairing">Pairing…</string>
    <string name="pair_try_again">Try again</string>
    <string name="pair_notice_revoked">This phone was removed from the laptop. Pair it again.</string>
    <string name="pair_notice_pair_again">The pairing stored on this phone can\'t be used any more. Pair it again.</string>

    <string name="fp_title">Compare the certificate fingerprint</string>
    <string name="fp_body">The laptop at %1$s answered with this certificate. All 16 groups must match what pair shows on the laptop.</string>
    <string name="fp_match">They match, pair</string>
    <string name="fp_no_match">They don\'t match</string>
    <string name="fp_matched">Fingerprint matched</string>

    <string name="code_error_invalid">Invalid or expired pairing code</string>
    <string name="code_error_help">A code works once and expires after 5 minutes. Run %1$s again on the laptop for a new one.</string>
    <string name="code_error_incomplete">Enter all 8 characters</string>

    <string name="address_error_empty">Enter the laptop\'s address</string>
    <string name="address_error_not_ip">Enter the IP address, like 192.168.1.23 or 100.101.102.103</string>
    <string name="address_error_port">The port must be a number from 1 to 65535</string>
    <string name="address_error_not_private">Only a home or office Wi-Fi address (192.168.x, 10.x, 172.16–31.x) or a Tailscale address (100.64–127.x) works. Aristotle never connects over the public internet.</string>
    <string name="address_error_unreachable">Can\'t reach this address. Check it, and check that aristotle-server is running on the laptop.</string>
    <string name="address_error_not_allowed">The laptop doesn\'t accept this phone on that address (different network). Use another address that pair shows.</string>
    <string name="address_error_no_certificate">Something answered here, but without a certificate. Use an address that pair shows.</string>

    <string name="pair_message_fp_rejected">Not paired. Another device may be answering at this address. Check that the phone is on your own Wi-Fi or Tailscale and that the address is the one pair shows.</string>
    <string name="pair_message_cert_changed">The certificate changed after you compared it. Not paired; start again.</string>
    <string name="pair_message_server_error">The laptop could not save this phone. Run %1$s again.</string>
    <string name="pair_message_store_failed">The laptop paired this phone, but the phone could not lock the pairing in its key store. Run %1$s again on the laptop, then pair again.</string>
    <string name="pair_message_rejected">The laptop refused the request (HTTP %1$d).</string>

