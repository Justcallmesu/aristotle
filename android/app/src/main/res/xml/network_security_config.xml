<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext to any host, no exceptions (spec Q49): every connection to the PC is HTTPS with its
  pinned certificate, on Wi-Fi and Tailscale alike (data/HttpClients.kt). User-installed CAs are
  never trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
