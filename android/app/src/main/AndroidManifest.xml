<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- T09: follow the default network to switch between Wi-Fi and Tailscale addresses. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- TL1 (Q65): LAN discovery holds a Wi-Fi multicast lock while NSD looks for the PC (normal permission, no prompt).
         NSD needs no location or nearby-devices permission on API 29-36 (see docs/protocol.md §15, phone side). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- T10: the specialUse foreground service that keeps the link open, and its notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- T10 battery guide step 1: Android's one-tap "don't optimise" dialog (sideloaded, spec Q11). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TS2 (Q94): see whether the broker app Ajaib is installed, to offer "Open" only then (package visibility, API 30+). -->
    <queries>
        <package android:name="ajaib.co.id" />
    </queries>

    <application
        android:name=".AristotleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aristotle"
        tools:targetApi="33">
        <!-- T08: ask Play services to fetch the code scanner module at install, so "Scan QR code" works offline the
             first time. The scanner brings its own camera UI: the app has no CAMERA permission. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T12b: notification taps open a session chat through this alias only. Not exported, so no other app can
             raise the prompt sheet or spoof the title; the launcher entry above never opens a session. -->
        <activity-alias
            android:name=".OpenSessionAlias"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- T16: the camera writes its picture into this app's cache through a content:// URI (ACTION_IMAGE_CAPTURE
             needs no CAMERA permission while the app declares none). Not exported; the camera app gets a one-off grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".background.AlertDismissReceiver"
            android:exported="false" />

        <service
            android:name=".background.LinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's own Hermes agent session link open so turn-finished and approval notifications arrive while the app is closed." />
        </service>

        <!-- TD40 (spec Q58): the code scanner's transitive Google datatransport/CCT stack only uploads ML Kit usage
             metrics. Removed so nothing is scheduled or sent to Google. The scanner itself (delegate activity,
             MlKitComponentDiscoveryService + its registrars, MlKitInitProvider) is kept. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>

</manifest>
