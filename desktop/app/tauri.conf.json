{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aristotle Server",
  "version": "0.0.0",
  "identifier": "dev.aristotle.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aristotle Server",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
