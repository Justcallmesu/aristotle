[Desktop Entry]
Type=Application
Name=Aristotle Server
Comment=Control the Aristotle server on this PC
# The installer (DS7) puts the quoted absolute path of the installed program in Exec (it replaces the placeholder directory on the next line).
Exec=@BIN_DIR@/aristotle-desktop
Icon=aristotle-server
Terminal=false
Categories=Utility;Network;
StartupWMClass=aristotle-desktop
