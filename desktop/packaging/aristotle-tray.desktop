[Desktop Entry]
Type=Application
Name=Aristotle Server
Comment=Tray icon and notifications for aristotle-server
# The installer (DS7) puts the quoted absolute path of the installed program in Exec (it replaces the placeholder directory on the next line).
Exec=@BIN_DIR@/aristotle-tray
Icon=aristotle-server
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
Hidden=false
